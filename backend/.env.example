# SentinelFusion AI Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Configuration
# Use SQLite by default for development without requiring PostgreSQL running.
# In production, switch to: postgresql+psycopg2://user:password@localhost:5432/sentinelfusion_db
DATABASE_URL=sqlite:///./sentinelfusion.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Future MQTT Broker Settings (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_DETECTIONS=sentinelfusion/events/detections
MQTT_TOPIC_ALERTS=sentinelfusion/events/alerts
